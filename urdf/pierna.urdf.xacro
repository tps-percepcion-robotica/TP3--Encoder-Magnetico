<?xml version="1.0"?>
<robot name="pierna_encoder" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Colores -->
  <material name="gris">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>
  <material name="naranja">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>

  <!-- Base fija (cadera  en el aire ,la referencia) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.08 0.08 0.02"/>
      </geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Muslo -->
  <link name="muslo_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.3"/>
      </geometry>
      <material name="naranja"/>
    </visual>
  </link>

  <!-- Joint cadera potenciometro -->
  <joint name="joint_cadera" type="revolute">
    <parent link="base_link"/>
    <child link="muslo_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Pierna-->
  <link name="pierna_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.3"/>
      </geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Joint rodilla el AS5600 -->
  <joint name="joint_rodilla" type="revolute">
    <parent link="muslo_link"/>
    <child link="pierna_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.09" effort="10" velocity="1"/>
  </joint>

</robot>