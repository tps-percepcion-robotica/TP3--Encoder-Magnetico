<launch>
  <!-- Levanta todo el pipeline real: micro-ROS agent -> potenciómetro (ESP32)
       -> nodo de calibración -> robot_state_publisher -> RViz.
       Requiere el firmware de potenciometro_firmware/ ya flasheado y encendido,
       y que la calibración ya exista en config/calibracion_potenciometros.yaml
       (correr calibrar_potenciometro.py antes si hace falta). -->

  <let name="urdf_path" value="$(find-pkg-share pierna_encoder_pkg)/urdf/pierna.urdf.xacro" />
  <let name="rviz_config_path" value="$(find-pkg-share pierna_encoder_pkg)/rviz/pierna.rviz" />

  <node pkg="micro_ros_agent" exec="micro_ros_agent" name="micro_ros_agent"
        args="udp4 --port 8888" output="screen" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" type="str" />
  </node>

  <node pkg="pierna_encoder_pkg" exec="calibracion_node" name="calibracion_potenciometro_node" output="screen">
    <param name="pot_id" value="pierna_1" />
    <param name="raw_topic" value="/posicion" />
    <param name="angulo_topic" value="/pierna_1/angulo_rad" />
    <param name="joint_name" value="joint_cadera" />
    <param name="joint_states_topic" value="/joint_states_sensores" />
  </node>

  <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher" output="screen">
    <param name="source_list" value="[/joint_states_sensores]" type="list_of_str" />
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_config_path)" output="screen" />
</launch>
